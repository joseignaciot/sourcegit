<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.WelcomeToolbar"
             x:DataType="vm:Welcome">
  <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,0">
    <StackPanel Grid.Column="0" Orientation="Horizontal">
      <Button Classes="icon_button" Width="32" Command="{Binding Clone}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical" MaxWidth="300">
            <TextBlock>
              <Run Text="{DynamicResource Text.Welcome.Clone}"/>
              <Run Text=" "/>
              <Run Text="{OnPlatform Ctrl+R, macOS=⌘+R}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
            </TextBlock>
            <TextBlock Classes="small" Margin="0,4,0,0" TextWrapping="Wrap" Text="{DynamicResource Text.Tip.Clone}"/>
          </StackPanel>
        </ToolTip.Tip>
        <Path Width="16" Height="16" Data="{StaticResource Icons.Clone}" Margin="0,4,0,0"/>
      </Button>

      <Button Classes="icon_button" Width="32" Command="{Binding OpenLocalRepository}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical" MaxWidth="300">
            <TextBlock>
              <Run Text="{DynamicResource Text.Welcome.OpenOrInit}"/>
              <Run Text=" "/>
              <Run Text="{OnPlatform Ctrl+L, macOS=⌘+L}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
            </TextBlock>
            <TextBlock Classes="small" Margin="0,4,0,0" TextWrapping="Wrap" Text="{DynamicResource Text.Tip.OpenOrInit}"/>
          </StackPanel>
        </ToolTip.Tip>
        <Path Width="14" Height="14" Data="{StaticResource Icons.Folder.Open}" Margin="0,2,0,0"/>
      </Button>

      <Button Classes="icon_button" Width="32" Command="{Binding OpenTerminal}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical" MaxWidth="300">
            <TextBlock>
              <Run Text="{DynamicResource Text.Welcome.OpenTerminal}"/>
              <Run Text=" "/>
              <Run Text="{OnPlatform Ctrl+`, macOS=Λ+`}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
            </TextBlock>
            <TextBlock Classes="small" Margin="0,4,0,0" TextWrapping="Wrap" Text="{DynamicResource Text.Tip.OpenTerminal}"/>
          </StackPanel>
        </ToolTip.Tip>
        <Path Width="13" Height="13" Data="{StaticResource Icons.Terminal}"/>
      </Button>
    </StackPanel>

    <StackPanel Grid.Column="2" Orientation="Horizontal">
      <Button Classes="icon_button" Width="32" Command="{Binding ConfigureForgeToken}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical" MaxWidth="300">
            <TextBlock Text="{DynamicResource Text.Welcome.ForgeToken}"/>
            <TextBlock Classes="small" Margin="0,4,0,0" TextWrapping="Wrap" Text="{DynamicResource Text.Tip.ForgeToken}"/>
          </StackPanel>
        </ToolTip.Tip>
        <Path Width="14" Height="14" Margin="0,2,0,0" Data="{StaticResource Icons.Lock}"/>
      </Button>

      <Button Classes="icon_button" Width="32" Command="{Binding ToggleWorkspaceOnly}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical" MaxWidth="300">
            <TextBlock Text="{DynamicResource Text.Welcome.WorkspaceOnly}"/>
            <TextBlock Classes="small" Margin="0,4,0,0" TextWrapping="Wrap" Text="{DynamicResource Text.Tip.WorkspaceOnly}"/>
          </StackPanel>
        </ToolTip.Tip>
        <Grid Width="16" Height="16">
          <Path Width="14" Height="14" Margin="0,2,0,0" Data="{StaticResource Icons.Workspace}"/>
          <Border Width="6" Height="6" CornerRadius="3"
                  HorizontalAlignment="Right" VerticalAlignment="Top"
                  Background="{DynamicResource Brush.Accent}"
                  IsVisible="{Binding WorkspaceOnly}"/>
        </Grid>
      </Button>

      <Button Classes="icon_button" Width="32" Command="{Binding AddRootNode}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical" MaxWidth="300">
            <TextBlock Text="{DynamicResource Text.Welcome.AddRootFolder}"/>
            <TextBlock Classes="small" Margin="0,4,0,0" TextWrapping="Wrap" Text="{DynamicResource Text.Tip.AddRootFolder}"/>
          </StackPanel>
        </ToolTip.Tip>
        <Path Width="14" Height="14" Margin="0,2,0,0" Data="{StaticResource Icons.Folder.Add}"/>
      </Button>

      <Button Classes="icon_button" Width="32" Command="{Binding ScanDefaultCloneDir}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical" MaxWidth="300">
            <TextBlock Text="{DynamicResource Text.Welcome.ScanDefaultCloneDir}"/>
            <TextBlock Classes="small" Margin="0,4,0,0" TextWrapping="Wrap" Text="{DynamicResource Text.Tip.Scan}"/>
          </StackPanel>
        </ToolTip.Tip>
        <Path Width="14" Height="14" Data="{StaticResource Icons.Scan}"/>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
